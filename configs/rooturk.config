# ROOTURK fragment — applied after gki_defconfig + rooturk_gki.config.
# Used by scripts/fix-rooturk-config.sh (scripts/config + olddefconfig).

CONFIG_LOCALVERSION="-android15-8-4k"
# CONFIG_LOCALVERSION_AUTO is not set

# Vendor GKI ABI. Do not enable TRIM_UNUSED_KSYMS without a Kleaf
# abi_symbollist.raw — over-trim bootloops on rodin.
# CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE is not set
# CONFIG_ARCH_WANTS_DYNAMIC_TASK_STRUCT is not set

CONFIG_ARM64_MTE=y
CONFIG_KASAN=y
CONFIG_KASAN_HW_TAGS=y
CONFIG_KASAN_VMALLOC=y

CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZPOOL=y
CONFIG_ZBUD=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZBUD=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_KSM=y

CONFIG_TLS=y
CONFIG_STREAM_PARSER=y
CONFIG_MEMFD_ASHMEM_SHIM=y
CONFIG_PM_AUTOSLEEP=y

# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_PROTECT is not set

# Game ping: TEO parks the little CPU in s2idle (~20 ms wakeup) while
# MediaTek wlan IRQs are pinned there. MENU stays; vendor still provides
# lpm_gov_mhsp.
CONFIG_CPU_IDLE_GOV_MENU=y
# CONFIG_CPU_IDLE_GOV_TEO is not set
